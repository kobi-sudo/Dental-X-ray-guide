<!DOCTYPE html>
<!-- saved from url=(0077)file:///Users/villageveterinarysurgery/Downloads/vet-dental-xray-guide_3.html -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Veterinary Dental Radiography — Team Reference Guide</title>
<style>
*,*::before,*::after{{box-sizing:border-box;margin:0;padding:0}}
:root{{
  --teal-50:#E1F5EE;--teal-100:#9FE1CB;--teal-200:#5DCAA5;
  --teal-600:#0F6E56;--teal-800:#085041;
  --blue-50:#E6F1FB;--blue-100:#B5D4F4;--blue-800:#0C447C;
  --amber-50:#FAEEDA;--amber-100:#FAC775;--amber-800:#633806;
  --red-50:#FCEBEB;--red-100:#F7C1C1;--red-800:#791F1F;
  --gray-50:#F1EFE8;--gray-100:#D3D1C7;--gray-400:#888780;
  --gray-600:#5F5E5A;--gray-900:#2C2C2A;
  --coral-50:#FAECE7;--coral-100:#F5C4B3;--coral-800:#712B13;
}}
body{{font-family:Georgia,serif;background:#f7f6f2;color:var(--gray-900);line-height:1.6}}

/* HEADER */
.header{{background:var(--teal-800);color:white;padding:2rem 2.5rem 0;border-bottom:4px solid var(--teal-200)}}
.header-top{{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1rem;padding-bottom:1.5rem}}
.header h1{{font-size:1.7rem;font-weight:700;letter-spacing:-0.02em;line-height:1.2}}
.header .sub{{font-size:0.9rem;opacity:.8;margin-top:.3rem;font-style:italic}}
.hbadge{{background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:6px;padding:.4rem .9rem;font-size:.8rem;font-family:sans-serif;white-space:nowrap}}
.tab-bar{{display:flex;flex-wrap:wrap;border-bottom:2px solid rgba(255,255,255,.2)}}
.tab{{padding:.6rem 1.2rem;font-size:.85rem;font-family:sans-serif;font-weight:500;cursor:pointer;border:none;background:transparent;color:rgba(255,255,255,.65);border-bottom:2px solid transparent;margin-bottom:-2px;transition:.15s;letter-spacing:.02em}}
.tab:hover{{color:rgba(255,255,255,.9)}}
.tab.active{{color:white;border-bottom-color:#5DCAA5}}

/* MAIN */
.main{{max-width:1100px;margin:0 auto;padding:2rem 1.5rem}}
.section{{display:none}}.section.active{{display:block}}
.sec-label{{font-family:sans-serif;font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--teal-600);margin-bottom:.5rem}}
.sec-title{{font-size:1.4rem;font-weight:700;margin-bottom:.4rem}}
.sec-desc{{font-size:.9rem;color:var(--gray-600);font-family:sans-serif;margin-bottom:2rem}}

/* VIEW CARDS */
.view-card{{background:white;border:1px solid var(--gray-100);border-radius:10px;overflow:hidden;margin-bottom:1.5rem}}
.vc-head{{padding:1rem 1.25rem .75rem;border-bottom:1px solid var(--gray-100);display:flex;justify-content:space-between;align-items:flex-start}}
.vc-title{{font-size:1rem;font-weight:700;line-height:1.3}}
.vc-sub{{font-size:.78rem;color:var(--gray-400);font-family:sans-serif;margin-top:2px}}
.badge{{background:var(--teal-50);color:var(--teal-800);font-size:.75rem;font-weight:700;font-family:sans-serif;padding:3px 9px;border-radius:5px;white-space:nowrap;border:1px solid var(--teal-100)}}
.badge.p{{background:var(--blue-50);color:var(--blue-800);border-color:var(--blue-100)}}
.badge.o{{background:var(--amber-50);color:var(--amber-800);border-color:var(--amber-100)}}
.vc-body{{display:grid;grid-template-columns:1fr 1fr}}
.vc-info{{grid-column:1/-1;padding:1rem 1.25rem;border-top:1px solid var(--gray-100)}}
.vc-info dl{{font-family:sans-serif;font-size:.82rem;display:grid;grid-template-columns:auto 1fr;gap:.2rem 1rem}}
.vc-info dt{{font-weight:700;color:var(--gray-600);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;padding-top:.5rem}}
.vc-info dd{{padding-top:.5rem}}
.tips{{list-style:none;padding:0}}
.tips li{{position:relative;padding-left:1rem;font-size:.82rem;font-family:sans-serif;line-height:1.5;margin-bottom:2px}}
.tips li::before{{content:"→";position:absolute;left:0;color:var(--teal-200);font-size:.75rem;top:.1em}}
.warn{{background:var(--amber-50);border-left:3px solid var(--amber-100);padding:.5rem .75rem;border-radius:0 6px 6px 0;font-size:.8rem;font-family:sans-serif;color:var(--amber-800);margin-top:.6rem}}

/* DIAGRAMS */
.diag-wrap{{background:var(--gray-50);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1rem;min-height:180px}}
.diag-cap{{font-size:.75rem;color:var(--gray-400);font-family:sans-serif;margin-top:.5rem;text-align:center;font-style:italic}}
.diag-solo{{background:var(--gray-50);display:flex;align-items:center;justify-content:center;padding:1.5rem;border-radius:8px;margin-bottom:1rem}}

/* FULL MOUTH */
.fm-box{{background:white;border:1px solid var(--gray-100);border-radius:10px;padding:1.25rem 1.5rem;margin-bottom:2rem}}
.fm-title{{font-size:1rem;font-weight:700;margin-bottom:1rem;font-family:sans-serif}}
.fm-grid{{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}}
.fm-grid h4{{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal-600);margin-bottom:.75rem;font-family:sans-serif}}
.fm-list{{list-style:none;padding:0}}
.fm-list li{{display:flex;align-items:baseline;gap:.6rem;font-size:.83rem;font-family:sans-serif;padding:.3rem 0;border-bottom:1px solid var(--gray-50)}}
.fm-list li:last-child{{border-bottom:none}}
.fm-num{{background:var(--teal-800);color:white;font-size:.65rem;font-weight:700;min-width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}}
.fm-ang{{margin-left:auto;background:var(--gray-50);color:var(--gray-600);font-size:.72rem;padding:1px 7px;border-radius:4px;white-space:nowrap;font-weight:600}}

/* TECHNIQUE */
.tc{{background:white;border:1px solid var(--gray-100);border-radius:10px;padding:1.25rem 1.5rem;margin-bottom:1.25rem}}
.tc h3{{font-size:1.05rem;font-weight:700;margin-bottom:.3rem}}
.tc-desc{{font-size:.85rem;color:var(--gray-600);font-family:sans-serif;margin-bottom:1rem}}
.tc-row{{display:grid;grid-template-columns:220px 1fr;gap:1.5rem;align-items:start}}
.tc-rules h4{{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--teal-600);margin-bottom:.6rem;font-family:sans-serif}}
.slob{{background:var(--teal-50);border:1px solid var(--teal-100);border-radius:10px;padding:1.25rem 1.5rem;margin-bottom:2rem}}
.slob h3{{font-size:1rem;font-weight:700;color:var(--teal-800);margin-bottom:.5rem;font-family:sans-serif}}
.slob-rule{{font-size:1.4rem;font-weight:700;color:var(--teal-800);letter-spacing:.05em;margin:.75rem 0}}
.slob-desc{{font-size:.85rem;color:var(--teal-600);font-family:sans-serif;line-height:1.6}}

/* ERRORS */
.err-grid{{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem}}
.err-card{{background:white;border:1px solid var(--gray-100);border-radius:10px;overflow:hidden}}
.err-head{{padding:.9rem 1.25rem;display:flex;align-items:center;gap:.75rem;border-bottom:1px solid var(--gray-100)}}
.err-icon{{width:32px;height:32px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0}}
.err-name{{font-weight:700;font-size:.95rem;font-family:sans-serif}}
.err-body{{padding:.9rem 1.25rem;font-family:sans-serif;font-size:.82rem}}
.err-row{{display:flex;gap:.5rem;margin-bottom:.5rem}}
.err-row:last-child{{margin-bottom:0}}
.err-lbl{{font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gray-400);min-width:52px;padding-top:.1em}}
.fix{{color:var(--teal-600);font-weight:600}}

/* VIDEO CARDS */
.vid-grid{{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1.25rem;margin-bottom:2rem}}
.vid-card{{background:white;border:1px solid var(--gray-100);border-radius:10px;overflow:hidden;transition:box-shadow .15s}}
.vid-thumb{{height:150px;display:flex;align-items:center;justify-content:center;position:relative}}
.vid-badge{{position:absolute;bottom:8px;right:8px;background:rgba(0,0,0,.7);color:white;font-size:.7rem;padding:2px 7px;border-radius:4px;font-family:sans-serif}}
.vid-info{{padding:.85rem 1rem}}
.vid-title{{font-weight:700;font-size:.88rem;color:var(--gray-900);font-family:sans-serif;margin-bottom:4px;line-height:1.3}}
.vid-desc{{font-size:.78rem;color:var(--gray-600);font-family:sans-serif;line-height:1.5}}
.vid-link{{margin-top:6px;font-size:.72rem;color:var(--teal-600);font-family:sans-serif;font-weight:600}}
.vid-cat{{font-family:sans-serif;font-size:.78rem;font-weight:700;color:var(--gray-600);letter-spacing:.06em;text-transform:uppercase;margin-bottom:.75rem;padding-bottom:.4rem;border-bottom:1px solid var(--gray-100)}}

/* RESOURCES */
.res-grid{{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem}}
.res-card{{background:white;border:1px solid var(--gray-100);border-radius:10px;padding:1rem 1.25rem}}
.res-card h4{{font-size:.9rem;font-weight:700;font-family:sans-serif;margin-bottom:.25rem}}
.res-card p{{font-size:.8rem;color:var(--gray-600);font-family:sans-serif;margin-bottom:.5rem;line-height:1.5}}
.res-card a{{font-size:.8rem;color:var(--teal-600);font-family:sans-serif;text-decoration:none;font-weight:600}}

/* CHECKLIST */
.checklist{{background:var(--teal-800);color:white;border-radius:10px;padding:1.25rem 1.5rem;margin-top:2rem;font-family:sans-serif}}
.checklist-label{{font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;opacity:.7;margin-bottom:.75rem}}
.checklist-grid{{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:.75rem}}
.checklist-grid div{{font-size:.82rem;opacity:.9}}

footer{{margin-top:3rem;padding:1.5rem;background:white;border:1px solid var(--gray-100);border-radius:10px;font-family:sans-serif;font-size:.8rem;color:var(--gray-400);text-align:center}}

@media(max-width:700px){{
  .vc-body{{grid-template-columns:1fr}}
  .fm-grid,.tc-row{{grid-template-columns:1fr}}
  .header{{padding:1.25rem 1.25rem 0}}
  .header h1{{font-size:1.3rem}}
}}
@media print{{
  .tab-bar{{display:none}}
  .section{{display:block!important;page-break-before:always}}
  .section:first-of-type{{page-break-before:auto}}
  body{{background:white}}
}}
</style>
</head>
<body>

<div class="header">
  <div class="header-top">
    <div>
      <div style="font-family:sans-serif;font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;opacity:.7;margin-bottom:.4rem;">Village Veterinary Surgery</div>
      <h1>Dental Radiography<br>Team Reference Guide</h1>
      <div class="sub">Positioning · Angles · Techniques · Common Errors · Videos</div>
    </div>
    <div class="hbadge">Dogs &amp; Cats</div>
  </div>
  <div class="tab-bar">
    <button class="tab" onclick="showTab(&#39;dog&#39;,this)">🐕 Dog Views</button>
    <button class="tab" onclick="showTab(&#39;cat&#39;,this)">🐈 Cat Views</button>
    <button class="tab" onclick="showTab(&#39;technique&#39;,this)">Techniques</button>
    <button class="tab" onclick="showTab(&#39;errors&#39;,this)">Common Errors</button>
    <button class="tab active" onclick="showTab(&#39;resources&#39;,this)">Resources &amp; Videos</button>
  </div>
</div>

<div class="main">

<!-- ===== DOG ===== -->
<div class="section" id="tab-dog">
  <div class="sec-label">Canine</div>
  <div class="sec-title">Dog dental views</div>
  <div class="sec-desc">Use bisecting angle for maxillary and rostral mandibular teeth. Parallel technique for caudal mandibular premolars and molars. Full series = 12–16 views.</div>

  <!-- Max Incisors -->
  <div class="view-card">
    <div class="vc-head">
      <div><div class="vc-title">Maxillary incisors &nbsp;·&nbsp; 101–103 / 201–203</div><div class="vc-sub">Bisecting angle — one image captures all 6</div></div>
      <span class="badge">~60°</span>
    </div>
    <div class="vc-body">
      <div class="diag-wrap">
        <svg width="200" height="160" viewBox="0 0 200 160">
          <defs><marker id="a1" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#0F6E56"></path></marker></defs>
          <ellipse cx="100" cy="32" rx="78" ry="18" fill="#E1F5EE" stroke="#5DCAA5" stroke-width="1.5"></ellipse>
          <text x="100" y="36" text-anchor="middle" font-size="10" fill="#085041" font-family="Arial">Maxilla — rostral view</text>
          <line x1="100" y1="50" x2="100" y2="75" stroke="#aaa" stroke-width="1.2" stroke-dasharray="3,2"></line>
          <rect x="66" y="75" width="68" height="11" rx="3" fill="#B5D4F4" stroke="#185FA5" stroke-width="1"></rect>
          <text x="100" y="83" text-anchor="middle" font-size="8" fill="#0C447C" font-family="Arial">sensor</text>
          <line x1="100" y1="10" x2="100" y2="46" stroke="#0F6E56" stroke-width="2.5" marker-end="url(#a1)"></line>
          <path d="M100 50 L82 38 L100 75" fill="none" stroke="#FAC775" stroke-width="1.5" stroke-dasharray="4,2"></path>
          <text x="58" y="52" font-size="8.5" fill="#854F0B" font-family="Arial">bisect</text>
          <text x="100" y="108" text-anchor="middle" font-size="9.5" fill="#444" font-family="Arial" font-weight="bold">Beam: ~60° from vertical</text>
          <text x="100" y="122" text-anchor="middle" font-size="8.5" fill="#666" font-family="Arial">Sternal · sensor palatally · foam wedge</text>
          <text x="100" y="136" text-anchor="middle" font-size="8.5" fill="#666" font-family="Arial">Aim at root apex — not at the crown</text>
          <text x="100" y="150" text-anchor="middle" font-size="8.5" fill="#0F6E56" font-family="Arial">One image usually captures 101–203</text>
        </svg>
      </div>
      <div class="diag-wrap" style="background:white;flex-direction:column;gap:0.75rem;align-items:flex-start;padding:1.25rem;">
        <div style="font-family:sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal-600);">Key steps</div>
        <ul class="tips">
          <li>Patient sternal; palate parallel to table</li>
          <li>Sensor horizontal, placed palatally behind incisors</li>
          <li>Foam wedge holds sensor at correct angle</li>
          <li>Beam aimed rostrally at ~60° from vertical over bridge of nose</li>
          <li>If roots look stubby → reduce beam angle (overangulated)</li>
          <li>If roots look stretched → increase beam angle</li>
          <li>Increase exposure by ~15% vs standard setting</li>
        </ul>
      </div>
      <div class="vc-info">
        <dl>
          <dt>Sensor size</dt><dd>Size 2 (horizontal orientation)</dd>
          <dt>Watch for</dt><dd>Resorptive lesions at the gingival margin; root fractures; periapical lucency at apex</dd>
        </dl>
      </div>
    </div>
  </div>

  <!-- Mand Incisors -->
  <div class="view-card">
    <div class="vc-head">
      <div><div class="vc-title">Mandibular incisors &nbsp;·&nbsp; 301–303 / 401–403</div><div class="vc-sub">Near-parallel — shallow angle</div></div>
      <span class="badge p">~20°</span>
    </div>
    <div class="vc-body">
      <div class="diag-wrap">
        <svg width="200" height="160" viewBox="0 0 200 160">
          <defs><marker id="a2" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#0F6E56"></path></marker></defs>
          <rect x="30" y="52" width="140" height="22" rx="5" fill="#E1F5EE" stroke="#5DCAA5" stroke-width="1.5"></rect>
          <text x="100" y="66" text-anchor="middle" font-size="10" fill="#085041" font-family="Arial">Mandible</text>
          <rect x="64" y="80" width="72" height="11" rx="3" fill="#B5D4F4" stroke="#185FA5" stroke-width="1"></rect>
          <text x="100" y="88" text-anchor="middle" font-size="8" fill="#0C447C" font-family="Arial">sensor — near-parallel</text>
          <line x1="100" y1="10" x2="100" y2="48" stroke="#0F6E56" stroke-width="2.5" marker-end="url(#a2)"></line>
          <text x="100" y="108" text-anchor="middle" font-size="9.5" fill="#444" font-family="Arial" font-weight="bold">Beam: ~20° — very shallow</text>
          <text x="100" y="122" text-anchor="middle" font-size="8.5" fill="#666" font-family="Arial">Dorsal/sternal · chin tilted slightly up</text>
          <text x="100" y="136" text-anchor="middle" font-size="8.5" fill="#666" font-family="Arial">Sensor under tongue tip</text>
          <text x="100" y="150" text-anchor="middle" font-size="8.5" fill="#0F6E56" font-family="Arial">One image captures all 6 lower incisors</text>
        </svg>
      </div>
      <div class="diag-wrap" style="background:white;flex-direction:column;gap:0.75rem;align-items:flex-start;padding:1.25rem;">
        <div style="font-family:sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal-600);">Key steps</div>
        <ul class="tips">
          <li>Dorsal or sternal; chin elevated slightly</li>
          <li>Sensor placed under tongue behind lower incisors</li>
          <li>Much shallower angle than maxillary incisors</li>
          <li>Keep beam perpendicular to sensor in sagittal plane</li>
          <li>Mandibular symphysis clearly visible — assess for fractures</li>
        </ul>
      </div>
      <div class="vc-info">
        <dl>
          <dt>Sensor size</dt><dd>Size 2 (horizontal)</dd>
          <dt>Watch for</dt><dd>Symphysis lysis (cats especially); periodontal bone loss; root fractures</dd>
        </dl>
      </div>
    </div>
  </div>

  <!-- Max Canine -->
  <div class="view-card">
    <div class="vc-head">
      <div><div class="vc-title">Maxillary canine &nbsp;·&nbsp; 104 / 204</div><div class="vc-sub">Bisecting angle + lateral oblique — avoid PM3 superimposition</div></div>
      <span class="badge o">~60° oblique</span>
    </div>
    <div class="vc-body">
      <div class="diag-wrap">
        <svg width="200" height="170" viewBox="0 0 200 170">
          <defs><marker id="a3" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="#0F6E56"></path></marker></defs>
          <path d="M35 52 Q100 24 165 52 L162 82 Q100 96 38 82 Z" fill="#E1F5EE" stroke="#5DCAA5" stroke-width="1.5"></path>
          <text x="100" y="65" text-anchor="middle" font-size="9.5" fill="#085041" font-family="Arial">Maxilla — lateral view</text>
          <line x1="62" y1="82" x2="59" y2="26" stroke="#888" stroke-width="3" stroke-linecap="round"></line>
          <text x="46" y="24" font-size="8.5" fill="#444" font-family="Arial">104</text>
          <rect x="78" y="86" width="60" height="10" rx="3" fill="#B5D4F4" stroke="#185FA5" stroke-width="1"></rect>
          <text x="108" y="93" text-anchor="middle" font-size="8" fill="#0C447C" font-family="Arial">sensor</text>
          <line x1="38" y1="8" x2="60" y2="36" stroke="#0F6E56" stroke-width="2.5" marker-end="url(#a3)"></line>
          <text x="22" y="16" font-size="8" fill="#0F6E56" font-family="Arial">beam</text>
          <text x="100" y="116" text-anchor="middle" font-size="9.5" fill="#444" font-family="Arial" font-weight="bold">Lateral oblique ~60°</text>
          <text x="100" y="130" text-anchor="middle" font-size="8.5" fill="#666" font-family="Arial">Head tilted toward side of interest</text>
          <text x="100" y="144" text-anchor="middle" font-size="8.5" fill="#666" font-family="Arial">Beam aimed mesially to clear PM3</text>
          <text x="100" y="158" text-anchor="middle" font-size="8.5" fill="#c44" font-family="Arial">⚠ Confirm full root length on image</text>
        </svg>
      </div>
      <div class="diag-wrap" style="background:white;flex-direction:column;gap:0.75rem;align-items:flex-start;padding:1.25rem;">
        <div style="font-family:sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal-600);">Key steps</div>
        <ul class="tips">
          <li>Sternal; head tilted toward side being imaged</li>
          <li>Sensor palatally alongside canine; largest sensor available</li>
          <li>Foam wedge essential — very limited palatal space</li>
          <li>Beam aimed mesially — root must NOT overlap PM3</li>
          <li>Increase exposure by 10–15% — most underexposed view</li>
          <li>Periapical lucency at apex = endodontic disease</li>
        </ul>
      </div>
      <div class="vc-info">
        <dl>
          <dt>Sensor size</dt><dd>Size 4 if available; size 2 minimum</dd>
          <dt>Common mistake</dt><dd>Root tip cut off at sensor edge — use largest sensor and push apically</dd>
          <dt>Watch for</dt><dd>Periapical lucency; external root resorption; retained root post-extraction</dd>
        </dl>
        <div class="warn">⚠ Always include 3mm beyond the root apex — essential for periapical assessment</div>
      </div>
    </div>
  </div>

  <!-- Max 4th PM -->
  <div class="view-card">
    <div class="vc-head">
      <div><div class="vc-title">Maxillary 4th PM — carnassial &nbsp;·&nbsp; 108 / 208</div><div class="vc-sub">Three roots — bisecting angle + SLOB for separation</div></div>
      <span class="badge o">~45° + SLOB</span>
    </div>
    <div class="vc-body">
      <div class="diag-wrap">
        <svg width="200" height="170" viewBox="0 0 200 170">
